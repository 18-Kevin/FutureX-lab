# ===== Database =====
# Local dev: leave EMPTY — the server uses a local JSON file (no install needed).
# Production (Render): paste your MongoDB Atlas connection string here (in Render's env settings, not git).
MONGODB_URI=

# ===== JWT (login sessions) =====
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# ===== Email (Gmail needs an App Password, not your normal password) =====
EMAIL_SERVICE=gmail
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-16-character-app-password
EMAIL_FROM=your-email@gmail.com

# ===== AI (Groq — free tier, get a key at console.groq.com/keys) =====
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=openai/gpt-oss-120b

# ===== Server =====
NODE_ENV=development
PORT=3000
# Local dev:  http://localhost:3000
# Render:     https://futurexlab.vercel.app  (used for email links + CORS)
FRONTEND_URL=http://localhost:3000

# ===== Rate limiting =====
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
