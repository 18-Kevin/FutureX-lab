# ===== Database =====
# Local dev: leave EMPTY — the server uses a local JSON file (no install needed).
# Production (Render): paste your MongoDB Atlas connection string here (in Render's env settings, not git).
MONGODB_URI=

# ===== JWT (login sessions) =====
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# ===== Email (Brevo API over HTTPS — free tier, sign up at brevo.com) =====
# Get an API key: Brevo > Settings > SMTP & API > API Keys > Generate
# Sender must be verified: Brevo > Settings > Senders & IPs > Senders
BREVO_API_KEY=your_brevo_api_key
EMAIL_USER=your-verified-sender@gmail.com
EMAIL_FROM=your-verified-sender@gmail.com

# Legacy SMTP fallback — only works if your host allows outbound SMTP
# (Render FREE tier blocks ports 465/587 — use Brevo there)
EMAIL_SERVICE=gmail
EMAIL_PASSWORD=your-16-character-app-password

# ===== AI (Groq — free tier, get a key at console.groq.com/keys) =====
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=openai/gpt-oss-120b

# ===== Server =====
NODE_ENV=development
PORT=3000
# Local dev:  http://localhost:3000
# Render:     https://futurexlab.vercel.app  (used for email links + CORS)
FRONTEND_URL=http://localhost:3000

# ===== Rate limiting =====
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
