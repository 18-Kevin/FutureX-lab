  <script>
(() => {
  'use strict';

  const $ = (selector, root = document) => root.querySelector(selector);
  const $$ = (selector, root = document) => [...root.querySelectorAll(selector)];

  const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const coarsePointer = matchMedia('(pointer: coarse)').matches;

  document.body.classList.toggle('cursor-ready', !coarsePointer);

  const progress = $('#pageProgress span');
  const navbar = $('#navbar');
  const menuToggle = $('#menuToggle');
  const mobileMenu = $('#mobileMenu');

  function updatePage() {
    const height = document.documentElement.scrollHeight - innerHeight;
    if (progress) progress.style.width = `${height ? (scrollY / height) * 100 : 0}%`;
    navbar?.classList.toggle('scrolled', scrollY > 46);
  }

  addEventListener('scroll', updatePage, { passive: true });
  addEventListener('resize', updatePage);
  updatePage();

  /* Cursor and hero spotlight */
  const cursor = $('#cursorLens');
  const cursorCenter = $('#cursorCenter');
  const orbitA = $('.cursor-orbit-a');
  const orbitB = $('.cursor-orbit-b');
  const heroReveal = $('#heroReveal');

  const pointer = { x: innerWidth / 2, y: innerHeight / 2 };
  const smooth = { ...pointer };
  const slow = { ...pointer };

  addEventListener('pointermove', (event) => {
    pointer.x = event.clientX;
    pointer.y = event.clientY;
  }, { passive: true });

  function moveElement(element, x, y) {
    if (element) {
      element.style.transform = `translate3d(${x}px, ${y}px, 0) translate(-50%, -50%)`;
    }
  }

  function animateCursor() {
    if (coarsePointer || reduceMotion) return;

    smooth.x += (pointer.x - smooth.x) * 0.2;
    smooth.y += (pointer.y - smooth.y) * 0.2;
    slow.x += (pointer.x - slow.x) * 0.08;
    slow.y += (pointer.y - slow.y) * 0.08;

    moveElement(cursor, smooth.x, smooth.y);
    moveElement(orbitA, slow.x, slow.y);
    moveElement(orbitB, slow.x, slow.y);

    if (heroReveal) {
      const radius = Math.min(320, Math.max(180, innerWidth * 0.22));
      const mask = `radial-gradient(circle ${radius}px at ${slow.x}px ${slow.y}px, #000 0%, #000 40%, rgba(0,0,0,.8) 60%, transparent 100%)`;

      heroReveal.style.webkitMaskImage = mask;
      heroReveal.style.maskImage = mask;
    }

    requestAnimationFrame(animateCursor);
  }

  if (!coarsePointer && !reduceMotion) requestAnimationFrame(animateCursor);

  $$('a, button, input, textarea, select').forEach((element) => {
    element.addEventListener('mouseenter', () => {
      if (!cursor || coarsePointer) return;
      cursor.classList.add('is-hover');
      cursorCenter.textContent = element.id === 'aiToggle' ? '🤖' : '⌕';
    });

    element.addEventListener('mouseleave', () => {
      if (!cursor || coarsePointer) return;
      cursor.classList.remove('is-hover', 'is-ai', 'is-launch', 'is-brand');
      cursorCenter.textContent = '⌕';
    });
  });

  /* Mobile menu */
  menuToggle?.addEventListener('click', () => {
    const open = mobileMenu?.classList.toggle('open');
    menuToggle.classList.toggle('open', open);
    menuToggle.setAttribute('aria-expanded', String(open));
  });

  $$('.mobile-link').forEach((link) => {
    link.addEventListener('click', () => {
      mobileMenu?.classList.remove('open');
      menuToggle?.classList.remove('open');
      menuToggle?.setAttribute('aria-expanded', 'false');
    });
  });

  /* Active navigation and section entrance */
  const navLinks = $$('.nav-link');

  if ('IntersectionObserver' in window) {
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;

        navLinks.forEach((link) => {
          link.classList.toggle(
            'active',
            link.getAttribute('href') === `#${entry.target.id}`
          );
        });

        entry.target.classList.add('is-visible');
      });
    }, { rootMargin: '-25% 0px -50% 0px', threshold: 0.1 });

    $$('main[id], section[id], .reveal-on-scroll').forEach((item) => observer.observe(item));
  } else {
    $$('.reveal-on-scroll').forEach((item) => item.classList.add('is-visible'));
  }

  /* Card movement */
  $$('.magnetic-card').forEach((card) => {
    if (coarsePointer || reduceMotion) return;

    card.addEventListener('pointermove', (event) => {
      const box = card.getBoundingClientRect();
      const x = (event.clientX - box.left) / box.width - 0.5;
      const y = (event.clientY - box.top) / box.height - 0.5;

      card.style.transform =
        `perspective(900px) rotateX(${(-y * 2.6).toFixed(2)}deg) rotateY(${(x * 3.2).toFixed(2)}deg) translateY(-7px)`;
    });

    card.addEventListener('pointerleave', () => {
      card.style.transform = '';
    });
  });

  /* Trust intelligence */
  const trustData = {
    privacy: {
      score: 78,
      title: 'Privacy policy assessment',
      description: 'Several safeguards are present, but user control and third-party sharing deserve a closer read.',
      signals: [
        ['warn', 'Third-party sharing', 'Partner and analytics sharing language should be checked for scope.'],
        ['good', 'Retention language', 'A defined deletion and retention policy appears in this demo analysis.'],
        ['bad', 'Opt-out path', 'The user-control flow may require a manual request rather than a direct toggle.']
      ]
    },
    terms: {
      score: 62,
      title: 'Terms & conditions scan',
      description: 'Several clauses may materially affect users and should be explained before acceptance.',
      signals: [
        ['bad', 'Arbitration', 'The demo flags a potentially restrictive dispute-resolution clause.'],
        ['warn', 'Auto-renewal', 'Subscription renewal language deserves explicit attention.'],
        ['good', 'Content ownership', 'The demo indicates comparatively clear user content rights.']
      ]
    },
    platform: {
      score: 84,
      title: 'Platform policy evaluation',
      description: 'The demo shows generally clear controls with one notable tracking-related concern.',
      signals: [
        ['good', 'Security', 'Strong security language is surfaced in the simulated result.'],
        ['warn', 'Location access', 'Precise background location may deserve user scrutiny.'],
        ['good', 'User controls', 'Account-level controls are represented as relatively clear.']
      ]
    }
  };

  $$('.tool-tab').forEach((tab) => {
    tab.addEventListener('click', () => {
      const target = tab.dataset.target;

      $$('.tool-tab').forEach((item) => item.classList.toggle('active', item === tab));
      $$('.tool-panel').forEach((panel) => {
        panel.classList.toggle('active', panel.id === target);
      });

      $('#trustResults')?.classList.remove('active');
      $('#trustLoading')?.classList.remove('active');
    });
  });

  function displayTrustResult(type) {
    const data = trustData[type] || trustData.privacy;
    const loader = $('#trustLoading');
    const results = $('#trustResults');
    const scoreCircle = $('#resultCircle');
    const scoreText = $('#resultScore');

    loader?.classList.add('active');
    results?.classList.remove('active');

    setTimeout(() => {
      loader?.classList.remove('active');
      results?.classList.add('active');

      $('#resultTitle').textContent = data.title;
      $('#resultDesc').textContent = data.description;

      $('#resultSignals').innerHTML = data.signals.map(([kind, title, description]) => `
        <div class="signal-card ${kind}">
          <div class="signal-icon">${kind === 'good' ? '✓' : kind === 'warn' ? '!' : '×'}</div>
          <div><h5>${title}</h5><p>${description}</p></div>
        </div>
      `).join('');

      const circumference = 314;
      scoreCircle.style.stroke = data.score >= 75 ? '#65e6c1' : data.score >= 55 ? '#ffb36b' : '#ff6d83';
      scoreCircle.setAttribute('stroke-dasharray', `${(data.score / 100) * circumference} ${circumference}`);

      let value = 0;
      const interval = setInterval(() => {
        value += 2;
        if (value >= data.score) {
          value = data.score;
          clearInterval(interval);
        }
        scoreText.textContent = value;
      }, 20);
    }, 800);
  }

  $$('.analyze-btn').forEach((button) => {
    button.addEventListener('click', () => displayTrustResult(button.dataset.type));
  });

  $('.hint[data-fill="privacy"]')?.addEventListener('click', () => {
    $('#policyInput').value = 'https://example.com/privacy-policy';
  });

  /* Media-analysis prototype */
  const detectionData = {
    text: [73, 'Moderate confidence', 'AI-generation signal detected', 'This prototype detected a pattern worth reviewing. Production results should come from a validated detection model and present uncertainty clearly.'],
    image: [81, 'Moderate-high confidence', 'Synthetic-media signal detected', 'The interface is ready for metadata, provenance, and model-based image analysis.'],
    video: [68, 'Moderate confidence', 'Mixed provenance signal', 'Production analysis could combine frames, audio, metadata, and provenance signals.']
  };

  $$('.detect-tab').forEach((tab) => {
    tab.addEventListener('click', () => {
      $$('.detect-tab').forEach((item) => item.classList.toggle('active', item === tab));
      $$('.detect-panel').forEach((panel) => {
        panel.classList.toggle('active', panel.dataset.panel === tab.dataset.mode);
      });
    });
  });

  $$('.detection-btn').forEach((button) => {
    button.addEventListener('click', () => {
      const [score, confidence, title, description] = detectionData[button.dataset.type] || detectionData.text;
      button.disabled = true;
      const savedHTML = button.innerHTML;
      button.innerHTML = 'Analyzing <span>…</span>';

      setTimeout(() => {
        button.disabled = false;
        button.innerHTML = savedHTML;
        $('#detectMeter').style.width = `${score}%`;
        $('#detectScore').textContent = `${score}%`;
        $('#detectConfidence').textContent = confidence;
        $('#detectTitle').textContent = title;
        $('#detectDesc').textContent = description;
      }, 900);
    });
  });

  $$('input[type="file"]').forEach((input) => {
    input.addEventListener('change', () => {
      const file = input.files?.[0];
      const label = input.closest('.upload-zone')?.querySelector('b');
      if (file && label) label.textContent = file.name;
    });
  });

  /* News filters */
  let activeFilter = 'all';

  function filterNews() {
    const search = ($('#newsSearch')?.value || '').trim().toLowerCase();

    $$('.news-card').forEach((card) => {
      const categoryMatches = activeFilter === 'all' || card.dataset.category === activeFilter;
      const searchMatches = !search || card.textContent.toLowerCase().includes(search);
      card.classList.toggle('hidden', !(categoryMatches && searchMatches));
    });
  }

  $$('.filter-pill').forEach((filter) => {
    filter.addEventListener('click', () => {
      activeFilter = filter.dataset.filter;
      $$('.filter-pill').forEach((item) => item.classList.toggle('active', item === filter));
      filterNews();
    });
  });

  $('#newsSearch')?.addEventListener('input', filterNews);

  $('#newsSort')?.addEventListener('change', (event) => {
    const grid = $('#newsGrid');
    const key = event.target.value === 'impact' ? 'impact' : 'date';

    [...grid.children]
      .sort((a, b) => Number(b.dataset[key]) - Number(a.dataset[key]))
      .forEach((card) => grid.appendChild(card));
  });

  /* AI chat */
  const aiToggle = $('#aiToggle');
  const chatWindow = $('#chatWindow');
  const chatClose = $('#chatClose');
  const chatForm = $('#chatForm');
  const chatInput = $('#chatInput');
  const chatMessages = $('#chatMessages');
  const chatTyping = $('#chatTyping');

  function openChat() {
    chatWindow?.classList.add('open');
    aiToggle?.setAttribute('aria-expanded', 'true');
    chatInput?.focus();
  }

  function closeChat() {
    chatWindow?.classList.remove('open');
    aiToggle?.setAttribute('aria-expanded', 'false');
  }

  function addMessage(text, sender) {
    const message = document.createElement('div');
    message.className = `msg ${sender}`;
    message.textContent = text;
    chatMessages?.appendChild(message);
    chatMessages.scrollTop = chatMessages.scrollHeight;
  }

  async function getAIResponse(message) {
    /*
      This endpoint must run on your own server.
      The server stores your real API key safely and calls the AI provider.
    */
    const response = await fetch('/api/chat', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        message,
        system: 'You are the FutureX Lab assistant. Respond concisely and helpfully about AI, technology, trust, and privacy.'
      })
    });

    if (!response.ok) throw new Error('AI service unavailable');

    const data = await response.json();
    return data.reply || 'I could not generate a response right now.';
  }

  aiToggle?.addEventListener('click', () => {
    chatWindow?.classList.contains('open') ? closeChat() : openChat();
  });

  chatClose?.addEventListener('click', closeChat);

  chatForm?.addEventListener('submit', async (event) => {
    event.preventDefault();

    const text = chatInput?.value.trim();
    if (!text) return;

    addMessage(text, 'user');
    chatInput.value = '';
    chatTyping?.classList.add('active');

    try {
      const response = await getAIResponse(text);
      addMessage(response, 'bot');
    } catch {
      addMessage('The AI service is not connected yet. Please try again after configuring your server.', 'bot');
    } finally {
      chatTyping?.classList.remove('active');
    }
  });

  $$('.chat-suggest').forEach((button) => {
    button.addEventListener('click', () => {
      if (chatInput) chatInput.value = button.dataset.suggestion || button.textContent.trim();
      openChat();
      chatForm?.requestSubmit();
    });
  });

  addEventListener('pointerdown', (event) => {
    if (chatWindow?.classList.contains('open') && !chatWindow.contains(event.target) && !aiToggle.contains(event.target)) {
      closeChat();
    }
  });

  addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return;
    closeChat();
    mobileMenu?.classList.remove('open');
    menuToggle?.classList.remove('open');
    menuToggle?.setAttribute('aria-expanded', 'false');
  });
})();
</script>
</body>
</html>
