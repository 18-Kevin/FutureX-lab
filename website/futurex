line);display:flex;justify-content:space-between;font:500 9px var(--mono);color:var(--dim)}.chat-context b{color:var(--violet-2);font-weight:500}.chat-body{flex:1;overflow:auto;padding:18px;display:flex;flex-direction:column;gap:12px}.msg{max-width:86%;padding:11px 13px;border-radius:14px;font-size:12px;line-height:1.5}.msg.bot{align-self:flex-start;background:#20263a;color:#e9edfa;border-bottom-left-radius:4px}.msg.user{align-self:flex-end;background:var(--violet);color:#fff;border-bottom-right-radius:4px}.typing-indicator{display:none;gap:4px;margin:0 18px 10px;padding:10px 12px;width:max-content;border-radius:13px;background:#20263a}.typing-indicator.active{display:flex}.typing-indicator span{width:5px;height:5px;border-radius:50%;background:#b8c0d2;animation:typing 1.2s infinite}.typing-indicator span:nth-child(2){animation-delay:.15s}.typing-indicator span:nth-child(3){animation-delay:.3s}.chat-footer{padding:12px;border-top:1px solid var(--line);background:rgba(0,0,0,.18)}.chat-suggestions{display:flex;gap:6px;overflow:auto;margin-bottom:10px}.chat-suggest{white-space:nowrap;padding:7px 10px;border:1px solid var(--line);border-radius:999px;color:var(--dim);font:500 9px var(--mono)}.chat-suggest:hover{color:#fff;background:rgba(255,255,255,.06)}.chat-input-area{display:flex;gap:7px}.chat-input-area input{flex:1;min-width:0;border:1px solid var(--line);background:#0e1320;border-radius:12px;padding:11px 12px;outline:none;font-size:12px}.chat-input-area input:focus{border-color:rgba(181,168,255,.55)}.chat-send{width:42px;height:42px;border-radius:12px;background:var(--violet);display:grid;place-items:center;font-weight:700}.chat-send:hover{background:#9d83ff}
