.about-hero{display:flex;justify-content:space-between;gap:50px;align-items:flex-end}.about-image-wrap{height:560px;margin-top:75px;border-radius:28px;overflow:hidden;position:relative;border:1px solid var(--line);box-shadow:var(--shadow)}.about-image{position:absolute;inset:0;background:linear-gradient(0deg,rgba(7,10,18,.8),transparent 60%),url('https://images.unsplash.com/photo-1581091226825-a6a2a5aee158?q=80&w=2000&auto=format&fit=crop') center/cover;filter:saturate(.78) contrast(1.08)}.about-overlay{position:absolute;inset:auto 0 0 0;padding:36px;display:flex;align-items:end;justify-content:space-between;gap:20px}.about-overlay p{font:500 italic clamp(2rem,4vw,4rem)/.92 var(--serif);letter-spacing:-.04em}.about-line{width:20%;height:1px;background:rgba(255,255,255,.25)}.about-metrics{display:grid;grid-template-columns:repeat(4,1fr);margin-top:18px;border-top:1px solid var(--line);border-bottom:1px solid var(--line)}.about-metrics div{padding:28px 14px;border-right:1px solid var(--line)}.about-metrics div:last-child{border-right:0}.about-metrics strong{display:block;font:500 clamp(2.2rem,4vw,4.2rem) var(--serif);letter-spacing:-.05em}.about-metrics span{font:500 9px var(--mono);letter-spacing:.11em;color:var(--dim);text-transform:uppercase}

