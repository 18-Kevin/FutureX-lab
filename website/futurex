<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="theme-color" content="#070a12" />
  <meta name="description" content="FutureX Lab — research, trust intelligence, AI detection and technology signals." />
  <title>FutureX Lab — Build what comes next</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:ital,wght@1,500;1,600&display=swap" rel="stylesheet" />
  <style>
:root{
--bg:#070a12; --surface:#0c0f1b; --surface-2:#111526; --surface-3:#151a2a;
--ink:#f4f7ff; --muted:#b8c0d2; --dim:#7d879d; --violet:#8967ff; --violet-2:#b5a8ff;
--cyan:#62d8ff; --mint:#65e6c1; --warm:#ffb36b; --red:#ff6d83; --gold:#f4d06f; --lilac:#d8c9ff; --coral:#ff8f70;
--line:rgba(255,255,255,.105); --line-strong:rgba(255,255,255,.18);
--shadow:0 30px 100px rgba(0,0,0,.42); --ease:cubic-bezier(.16,1,.3,1);
--sans:'DM Sans',sans-serif; --serif:'Playfair Display',serif; --mono:'DM Mono',monospace;
}
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth;background:var(--bg)}
body{background:var(--bg);color:var(--ink);font-family:var(--sans);overflow-x:hidden;-webkit-font-smoothing:antialiased}
body::before{content:'';position:fixed;inset:0;pointer-events:none;z-index:-2;background:radial-gradient(circle at 14% 18%,rgba(216,201,255,.045),transparent 22%),radial-gradient(circle at 84% 38%,rgba(101,230,193,.035),transparent 20%),radial-gradient(circle at 48% 92%,rgba(255,143,112,.03),transparent 22%)}
body.cursor-ready{cursor:none}
a,button,input,textarea,select{font:inherit;color:inherit}a{text-decoration:none}button{border:0;background:none}button:focus-visible,a:focus-visible,input:focus-visible,textarea:focus-visible,select:focus-visible{outline:2px solid var(--violet-2);outline-offset:4px}
::selection{background:rgba(137,103,255,.35);color:#fff}
::-webkit-scrollbar{width:9px}::-webkit-scrollbar-track{background:#070a12}::-webkit-scrollbar-thumb{background:rgba(255,255,255,.16);border-radius:20px}

/* CURSOR */
.cursor-system{position:fixed;inset:0;pointer-events:none;z-index:9999}
.cursor-lens{position:fixed;left:0;top:0;width:42px;height:42px;border:1px solid rgba(218,211,255,.9);border-radius:50%;transform:translate3d(-50%,-50%,0);background:radial-gradient(circle at 34% 28%,rgba(255,255,255,.15),rgba(137,103,255,.045) 42%,rgba(0,0,0,.02));backdrop-filter:blur(2px);box-shadow:0 0 0 1px rgba(137,103,255,.08),0 0 32px rgba(137,103,255,.16);transition:width .28s var(--ease),height .28s var(--ease),background .28s,border-color .28s}
.lens-glint{position:absolute;width:11px;height:4px;border-radius:100%;background:rgba(255,255,255,.7);transform:rotate(-35deg);left:8px;top:8px;filter:blur(.2px)}
.lens-crosshair{position:absolute;background:rgba(213,207,255,.78);left:50%;top:50%;opacity:.8}.lens-crosshair-h{height:1px;width:14px;transform:translate(-50%,-50%)}.lens-crosshair-v{width:1px;height:14px;transform:translate(-50%,-50%)}
.lens-center{position:absolute;left:50%;top:50%;transform:translate(-50%,-49%);font:500 12px var(--mono);color:#ddd7ff}
.cursor-orbit{position:fixed;width:6px;height:6px;border:1px solid rgba(181,168,255,.55);border-radius:50%;transform:translate3d(-50%,-50%,0);opacity:.9}.cursor-orbit-a{width:56px;height:56px;border-style:dashed;border-color:rgba(137,103,255,.18)}.cursor-orbit-b{width:66px;height:66px;border-color:rgba(98,216,255,.08);border-style:dotted}
.cursor-lens.is-hover{width:58px;height:58px;background:rgba(137,103,255,.1);border-color:#c7bcff}.cursor-lens.is-ai{width:70px;height:70px;border-style:dashed;border-color:var(--cyan);background:rgba(98,216,255,.08);box-shadow:0 0 45px rgba(98,216,255,.14)}.cursor-lens.is-ai .lens-center{font-size:19px;color:var(--cyan)}
.cursor-lens.is-launch{width:64px;height:64px;border-color:#fff}.cursor-lens.is-brand{width:52px;height:52px}
@media(pointer:coarse){.cursor-system{display:none}body{cursor:auto!important}.magnetic-target{cursor:pointer!important}}

/* GLOBAL */
.page-progress{position:fixed;top:0;left:0;width:100%;height:2px;z-index:500;background:transparent}.page-progress span{display:block;width:0;height:100%;background:linear-gradient(90deg,var(--violet),var(--cyan));box-shadow:0 0 12px rgba(137,103,255,.7)}
.nav{position:fixed;top:0;left:0;right:0;height:86px;padding:20px 40px;display:flex;align-items:center;justify-content:space-between;z-index:400;transition:height .45s var(--ease),padding .45s var(--ease),background .45s,border .45s}.nav.scrolled{height:72px;padding:14px 40px;background:rgba(7,10,18,.74);backdrop-filter:blur(18px);border-bottom:1px solid var(--line)}
.brand{display:flex;align-items:center;gap:12px;font-weight:700;font-size:21px;letter-spacing:-.055em;position:relative;z-index:2}.brand em{font-family:var(--serif);font-weight:500}.mark{width:28px;height:28px;border:1px solid rgba(255,255,255,.85);display:grid;place-items:center;transform:rotate(45deg);transition:transform .7s var(--ease),box-shadow .4s}.brand:hover .mark{transform:rotate(135deg);box-shadow:0 0 22px rgba(137,103,255,.22)}.mark i{width:9px;height:9px;border-radius:50%;background:#b09bff;box-shadow:0 0 18px rgba(176,155,255,.55)}
.nav-pill{position:absolute;left:50%;transform:translateX(-50%);display:flex;gap:3px;padding:5px;border:1px solid var(--line);border-radius:999px;background:rgba(17,20,33,.38);backdrop-filter:blur(18px);box-shadow:0 14px 40px rgba(0,0,0,.12)}
.nav-link{position:relative;padding:9px 15px;border-radius:999px;color:rgba(255,255,255,.68);font-size:13px;font-weight:600;transition:color .25s,background .25s}.nav-link span{position:absolute;left:15px;right:15px;bottom:5px;height:1px;background:var(--violet-2);transform:scaleX(0);transform-origin:left;transition:transform .32s var(--ease)}.nav-link:hover,.nav-link.active{color:#fff;background:rgba(255,255,255,.085)}.nav-link:hover span,.nav-link.active span{transform:scaleX(1)}
.nav-cta{display:inline-flex;align-items:center;gap:10px;padding:11px 15px 11px 17px;border:1px solid var(--line-strong);border-radius:999px;background:rgba(255,255,255,.025);font-size:13px;font-weight:700;transition:transform .3s var(--ease),background .3s,border-color .3s}.nav-cta b{font-size:16px;color:var(--violet-2);transition:transform .3s var(--ease)}.nav-cta:hover{background:#fff;color:#0a0d16;border-color:#fff;transform:translateY(-2px)}.nav-cta:hover b{transform:translate(2px,-2px);color:#6e52da}
.menu-toggle{display:none;width:42px;height:42px;border:1px solid var(--line-strong);border-radius:50%;position:relative}.menu-toggle span{position:absolute;width:15px;height:1px;background:#fff;left:50%;top:50%;transform:translate(-50%,-4px);transition:transform .25s}.menu-toggle span+span{transform:translate(-50%,4px)}.menu-toggle.open span{transform:translate(-50%,0) rotate(45deg)}.menu-toggle.open span+span{transform:translate(-50%,0) rotate(-45deg)}
.mobile-menu{position:fixed;inset:72px 0 auto 0;height:calc(100vh - 72px);z-index:350;background:rgba(6,9,15,.96);backdrop-filter:blur(24px);opacity:0;pointer-events:none;transform:translateY(-12px);transition:.4s var(--ease);border-top:1px solid var(--line)}.mobile-menu.open{opacity:1;pointer-events:auto;transform:none}.mobile-menu-inner{padding:30px 22px}.mobile-link{display:flex;justify-content:space-between;padding:18px 0;border-bottom:1px solid var(--line);font-size:25px;letter-spacing:-.04em}.mobile-link span{font:500 11px var(--mono);color:var(--violet-2);align-self:center}

/* HERO */
.hero{position:relative;min-height:100vh;min-height:100svh;overflow:hidden;background:#070a12;isolation:isolate}.hero-img{position:absolute;inset:0;background-size:cover;background-position:center}.hero-base{background-image:linear-gradient(105deg,rgba(3,5,12,.8),rgba(3,5,12,.2) 58%,rgba(3,5,12,.6)),url('https://images.higgs.ai/?default=1&output=webp&url=https%3A%2F%2Fd8j0ntlcm91z4.cloudfront.net%2Fuser_38xzZboKViGWJOttwIXH07lWA1P%2Fhf_20260609_195923_b0ba8ace-1d1d-4f2c-9a28-1ab84b330680.png&w=1280&q=85');animation:heroZoom 2s var(--ease) forwards}.hero-reveal{background-image:linear-gradient(105deg,rgba(3,5,12,.4),rgba(3,5,12,.1)),url('https://images.higgs.ai/?default=1&output=webp&url=https%3A%2F%2Fd8j0ntlcm91z4.cloudfront.net%2Fuser_38xzZboKViGWJOttwIXH07lWA1P%2Fhf_20260609_201152_bba90a12-bf12-459f-91f0-51f237dbaf3b.png&w=1280&q=85');z-index:2;pointer-events:none}.grain{position:absolute;inset:0;z-index:3;opacity:.12;pointer-events:none;background-image:url("data:image/svg+xml,%3Csvg viewBox='0 0 160 160' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.8'/%3E%3C/svg%3E");mix-blend-mode:soft-light}.hero-vignette{position:absolute;inset:0;z-index:4;background:radial-gradient(circle at 50% 46%,transparent 0,transparent 42%,rgba(3,5,12,.22) 78%,rgba(3,5,12,.56) 100%);pointer-events:none}
.hero-content{position:relative;z-index:5;min-height:100vh;display:flex;flex-direction:column;justify-content:space-between;padding:0 9vw 60px}.headline{margin-top:18vh;text-align:center;pointer-events:none}.eyebrow{font:500 12px var(--mono);letter-spacing:.2em;color:var(--violet-2);text-transform:uppercase;margin-bottom:24px}.headline h1{margin:0;font-size:clamp(3rem,7vw,7.5rem);line-height:.85;letter-spacing:-.06em;font-weight:600}.headline .accent{display:block;font:500 italic clamp(3rem,7vw,7.5rem) var(--serif);letter-spacing:-.05em;color:#fff}.hero-bottom{display:grid;grid-template-columns:280px minmax(280px,380px);justify-content:space-between;align-items:end;gap:40px}.hero-note{margin:0;color:rgba(255,255,255,.85);font-size:15px;line-height:1.6}.hero-action{display:flex;flex-direction:column;align-items:flex-start;gap:24px}.btn-launch,.btn-primary{display:inline-flex;align-items:center;justify-content:center;gap:12px;background:var(--violet);color:white;border-radius:999px;padding:15px 20px;font-size:14px;font-weight:700;box-shadow:0 16px 40px rgba(115,83,255,.27);transition:transform .32s var(--ease),background .32s,box-shadow .32s}.btn-launch:hover,.btn-primary:hover{background:#9d83ff;transform:translateY(-3px);box-shadow:0 20px 48px rgba(115,83,255,.42)}.btn-launch span,.btn-primary span{font-size:18px;line-height:1}.hero-scroll-cue{position:absolute;right:40px;bottom:34px;z-index:6;display:flex;flex-direction:column;align-items:center;gap:8px;color:rgba(255,255,255,.56)}.hero-scroll-cue span{display:block;width:1px;height:58px;background:linear-gradient(180deg,transparent,#fff)}.hero-scroll-cue small{font:500 9px var(--mono);letter-spacing:.12em;text-transform:uppercase;writing-mode:vertical-rl}
.anim-rise{opacity:0;animation:rise 1.2s var(--ease) forwards}.d-1{animation-delay:.2s}.d-2{animation-delay:.4s}.d-3{animation-delay:.6s}.d-4{animation-delay:.8s}@keyframes rise{from{opacity:0;transform:translateY(30px);filter:blur(10px)}to{opacity:1;transform:none;filter:blur(0)}}@keyframes heroZoom{from{transform:scale(1.1)}to{transform:scale(1)}}

/* SECTIONS */
.ambient-divider{height:38px;background:#0a0d16;display:flex;align-items:center;justify-content:center;gap:10px;border-top:1px solid var(--line);border-bottom:1px solid var(--line)}.ambient-divider span{display:block;width:4px;height:4px;border-radius:50%;background:var(--violet-2);opacity:.5}.ambient-divider span:nth-child(2){width:38px;height:1px;border-radius:0;opacity:.22}.section{position:relative;padding:135px 9vw;border-top:1px solid rgba(255,255,255,.05);overflow:hidden}.work-section{background:radial-gradient(circle at 90% 20%,rgba(137,103,255,.08),transparent 30%),linear-gradient(180deg,#090c14,#080b13)}.trust-section{background:radial-gradient(circle at 100% 0,rgba(137,103,255,.13),transparent 42%),#0a0d16}.detection-section{background:radial-gradient(circle at 0 50%,rgba(98,216,255,.08),transparent 38%),#090c14}.signals-section{background:linear-gradient(180deg,#090c14,#070a12)}.news-section{background:radial-gradient(circle at 50% 0,rgba(137,103,255,.07),transparent 35%),#070a12}.about-section{background:radial-gradient(circle at 70% 40%,rgba(137,103,255,.16),transparent 45%),#080b14}
.section-topline{display:flex;justify-content:space-between;align-items:center;margin-bottom:24px}.kicker,.micro-label{font:500 11px var(--mono);letter-spacing:.16em;text-transform:uppercase;color:var(--violet-2)}.section-index{font:500 11px var(--mono);color:var(--dim)}.section-title{font-size:clamp(2.8rem,5.8vw,6.2rem);line-height:.92;letter-spacing:-.065em;font-weight:600;max-width:950px}.section-title em{font:500 italic .95em var(--serif);color:#fff}.section-intro{font-size:18px;color:var(--muted);line-height:1.65;max-width:680px}.section-lead-row{margin-top:36px;display:flex;justify-content:space-between;gap:60px;align-items:flex-end}.mini-stamp{min-width:160px;display:flex;gap:12px;align-items:flex-end;justify-content:flex-end;color:var(--dim)}.mini-stamp span{font:500 26px var(--mono);color:var(--violet-2)}.mini-stamp b{font:500 8px/1.5 var(--mono);letter-spacing:.12em}
.reveal-on-scroll{opacity:0;transform:translateY(30px);transition:opacity .8s var(--ease),transform .8s var(--ease);transition-delay:var(--delay,0s)}.reveal-on-scroll.is-visible{opacity:1;transform:none}

/* WORK */
.work-grid{display:grid;grid-template-columns:1.35fr 1fr 1fr;gap:18px;margin-top:70px}.feature-card{min-height:530px;padding:26px;border:1px solid var(--line);border-radius:24px;background:linear-gradient(145deg,rgba(137,103,255,.09),rgba(255,255,255,.018));position:relative;overflow:hidden;display:flex;flex-direction:column;justify-content:space-between;transition:transform .45s var(--ease),border-color .45s,background .45s}.feature-card:hover{transform:translateY(-8px);border-color:rgba(181,168,255,.36);background:linear-gradient(145deg,rgba(137,103,255,.14),rgba(255,255,255,.028))}.feature-card-large{min-height:590px}.card-glow{position:absolute;inset:-50% auto auto -20%;width:500px;height:500px;background:radial-gradient(circle,rgba(137,103,255,.22),transparent 65%);pointer-events:none}.card-glow.cyan{background:radial-gradient(circle,rgba(98,216,255,.17),transparent 65%);inset:-50% -20% auto auto}.card-glow.warm{background:radial-gradient(circle,rgba(255,179,107,.16),transparent 65%);inset:auto -25% -45% auto}.feature-top{display:flex;justify-content:space-between;color:var(--dim);font:500 11px var(--mono);text-transform:uppercase;letter-spacing:.09em;position:relative;z-index:1}.feature-top i{font-style:normal;color:#fff;opacity:.55;transition:transform .3s var(--ease)}.feature-card:hover .feature-top i{transform:translate(3px,-3px);color:var(--violet-2)}.feature-copy{position:relative;z-index:1}.feature-copy h3{font-size:30px;letter-spacing:-.04em;margin-bottom:10px}.feature-copy p{font-size:14px;line-height:1.6;color:var(--muted);max-width:420px}.feature-visual{position:relative;display:grid;place-items:center;flex:1}.visual-orbit{min-height:220px}.orbit-ring{position:absolute;border:1px solid rgba(181,168,255,.22);border-radius:50%;transform:rotate(-18deg)}.orbit-ring.one{width:230px;height:110px;animation:float1 8s ease-in-out infinite}.orbit-ring.two{width:310px;height:150px;border-color:rgba(98,216,255,.12);transform:rotate(45deg);animation:float2 10s ease-in-out infinite}.orbit-core{width:78px;height:78px;border-radius:50%;display:grid;place-items:center;background:radial-gradient(circle at 35% 30%,#b9abff,var(--violet) 45%,#3e327e 100%);box-shadow:0 0 60px rgba(137,103,255,.34);font:500 16px var(--mono)}.visual-grid{grid-template-columns:repeat(3,34px);grid-auto-rows:34px;gap:10px;align-content:center;opacity:.75}.visual-grid span{border:1px solid rgba(98,216,255,.35);background:linear-gradient(145deg,rgba(98,216,255,.16),transparent);transform:rotate(45deg);animation:gridPulse 3s infinite}.visual-grid span:nth-child(2n){animation-delay:.4s}.visual-type{align-items:end;padding-bottom:30px}.visual-type span{display:block;font-size:clamp(28px,4vw,52px);letter-spacing:-.06em;line-height:.86;color:rgba(255,255,255,.11);transition:color .4s var(--ease),transform .4s var(--ease)}.feature-card:hover .visual-type span{color:rgba(255,255,255,.65);transform:translateX(4px)}
@keyframes float1{0%,100%{transform:rotate(-18deg) translateY(0)}50%{transform:rotate(-13deg) translateY(-8px)}}@keyframes float2{0%,100%{transform:rotate(45deg) scale(1)}50%{transform:rotate(52deg) scale(1.05)}}@keyframes gridPulse{0%,100%{opacity:.25}50%{opacity:.9}}

/* TRUST */
